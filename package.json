{
  "name": "assistente-mcp-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "syntax": "node scripts/check-syntax.mjs",
    "test": "node --test tests/*.test.js",
    "build:workers": "wrangler deploy --dry-run --outdir .wrangler-build/assistente --config wrangler.assistente.jsonc",
    "check": "npm run syntax && npm test && npm run build:workers"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.26.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}

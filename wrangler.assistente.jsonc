{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistente",
  "main": "src/host/worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "assistente.joaolds.xyz.br",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5a3768dfe8a7431c953f5ed0720825d6"
    }
  ],
  "vars": {
    "MCP_CLOUDFLARE_URL": "https://mcp.cloudflare.com/mcp"
  }
}

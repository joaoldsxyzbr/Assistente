{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistente",
  "main": "src/host/worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "assistente.joaolds.xyz.br",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5a3768dfe8a7431c953f5ed0720825d6"
    }
  ],
  "vars": {
    "MCP_CLOUDFLARE_URL": "https://mcp.cloudflare.com/mcp",
    "MCP_CLOUDFLARE_ACCOUNT_ID": "924f32dc9eeb8946dc033801c0c17c42",
    "MCP_GITHUB_URL": "https://api.githubcopilot.com/mcp/",
    "PONTO_D1_DATABASE_ID": "96b39cda-f037-4259-b406-09fea5431469",
    "GASTOS_D1_DATABASE_ID": "0c6c31c2-f2fd-4f60-9c75-b232019ae63f"
  }
}

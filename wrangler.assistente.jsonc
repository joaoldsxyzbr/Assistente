{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assistente",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "assistente.joaolds.xyz.br",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "5a3768dfe8a7431c953f5ed0720825d6"
    }
  ],
  "secrets": {
    "required": [
      "ASSISTENTE_OAUTH_PASSWORD",
      "UPSTREAM_OAUTH_ENCRYPTION_KEY",
      "GITHUB_OAUTH_CLIENT_ID",
      "GITHUB_OAUTH_CLIENT_SECRET"
    ]
  },
  "vars": {
    "MCP_CLOUDFLARE_URL": "https://mcp.cloudflare.com/mcp",
    "MCP_CLOUDFLARE_ACCOUNT_ID": "924f32dc9eeb8946dc033801c0c17c42",
    "MCP_GITHUB_URL": "https://api.githubcopilot.com/mcp/x/all",
    "PUBLIC_ORIGIN": "https://assistente.joaolds.xyz.br",
    "GITHUB_EXPECTED_LOGIN": "joaoldsxyzbr",
    "GITHUB_OAUTH_SCOPES": "repo read:org read:user user:email read:packages write:packages read:project project gist notifications workflow offline_access"
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "942101",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "942102",
      "simple": {
        "limit": 15,
        "period": 60
      }
    }
  ]
}
